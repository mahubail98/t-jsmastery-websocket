          "name": "POST /matches - finished match (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sport\": \"football\",\n  \"homeTeam\": \"Hidd\",\n  \"awayTeam\": \"Busaiteen\",\n  \"startTime\": \"{{pastStart}}\",\n  \"endTime\": \"{{pastEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('derives status = finished', () => pm.expect(pm.response.json().data.status).to.eql('finished'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches - list (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('newest first', () => {",
                  "    const ids = pm.response.json().data.map((m) => m.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches?limit=2 - page 1 (saves cursor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches?limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('at most 2 rows', () => pm.expect(pm.response.json().data.length).to.be.at.most(2));",
                  "pm.test('returns a pagination block', () => {",
                  "    const page = pm.response.json().pagination;",
                  "    pm.expect(page).to.have.property('limit', 2);",
                  "    pm.expect(page).to.have.property('hasMore');",
                  "    pm.expect(page).to.have.property('nextCursor');",
                  "});",
                  "pm.test('newest first', () => {",
                  "    const ids = pm.response.json().data.map((m) => m.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => b - a));",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('nextCursor', body.pagination.nextCursor || '');",
                  "pm.collectionVariables.set('page1Ids', JSON.stringify(body.data.map((m) => m.id)));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches?cursor - page 2 (no overlap)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches?limit=2&cursor={{nextCursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                },
                {
                  "key": "cursor",
                  "value": "{{nextCursor}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only meaningful when page 1 reported a further page.",
                  "if (!pm.collectionVariables.get('nextCursor')) {",
                  "    pm.test.skip('page 2 - no further page to fetch', () => {});",
                  "} else {",
                  "    pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "    pm.test('no overlap with page 1', () => {",
                  "        const page1 = JSON.parse(pm.collectionVariables.get('page1Ids'));",
                  "        const page2 = pm.response.json().data.map((m) => m.id);",
                  "        const overlap = page2.filter((id) => page1.includes(id));",
                  "        pm.expect(overlap).to.eql([]);",
                  "    });",
                  "    pm.test('continues below page 1', () => {",
                  "        const page1 = JSON.parse(pm.collectionVariables.get('page1Ids'));",
                  "        const page2 = pm.response.json().data.map((m) => m.id);",
                  "        if (page2.length) pm.expect(Math.max(...page2)).to.be.below(Math.min(...page1));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
