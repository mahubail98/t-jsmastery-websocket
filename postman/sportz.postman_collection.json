{
  "info": {
    "name": "Sportz API",
    "description": "Real-time sports API.\n\nSet the `baseUrl` collection variable (defaults to http://localhost:8000).\nStart the server with `npm run dev` before running this collection.\n\n## WebSocket\n\nThe server also exposes a WebSocket feed at `{{wsUrl}}` (ws://localhost:8000/ws).\nIt cannot be included as a request in this file: the Postman v2.1.0 collection\nschema has no WebSocket request type, a collection containing WebSocket requests\ncannot also contain HTTP requests, and Newman cannot execute WebSocket requests.\n\nSee the **Realtime (WebSocket)** folder for how to exercise it by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "matchId",
      "value": "",
      "type": "string"
    },
    {
      "key": "nextCursor",
      "value": "",
      "type": "string"
    },
    {
      "key": "page1Ids",
      "value": "[]",
      "type": "string"
    },
    {
      "key": "wsUrl",
      "value": "ws://localhost:8000/ws",
      "type": "string"
    },
    {
      "key": "commentaryId",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Timestamps are relative to now, so the 'live' and 'finished' cases",
          "// stay in the right window no matter when the collection is run.",
          "const now = Date.now();",
          "const iso = (ms) => new Date(ms).toISOString();",
          "pm.collectionVariables.set('liveStart', iso(now - 3600000));",
          "pm.collectionVariables.set('liveEnd', iso(now + 3600000));",
          "pm.collectionVariables.set('pastStart', iso(now - 14400000));",
          "pm.collectionVariables.set('pastEnd', iso(now - 7200000));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET / - health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a message', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "POST /matches - live match (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sport\": \"football\",\n  \"homeTeam\": \"Riffa\",\n  \"awayTeam\": \"Muharraq\",\n  \"startTime\": \"{{liveStart}}\",\n  \"endTime\": \"{{liveEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('derives status = live', () => pm.expect(pm.response.json().data.status).to.eql('live'));",
                  "pm.test('scores default to 0', () => {",
                  "    const match = pm.response.json().data;",
                  "    pm.expect(match.homeScore).to.eql(0);",
                  "    pm.expect(match.awayScore).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set('matchId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /matches - scheduled match, coerced scores (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sport\": \"basketball\",\n  \"homeTeam\": \"Manama\",\n  \"awayTeam\": \"Sitra\",\n  \"startTime\": \"2030-01-01T18:00:00Z\",\n  \"endTime\": \"2030-01-01T20:00:00Z\",\n  \"homeScore\": \"2\",\n  \"awayScore\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('derives status = scheduled', () => pm.expect(pm.response.json().data.status).to.eql('scheduled'));",
                  "pm.test('coerces string score to number', () => pm.expect(pm.response.json().data.homeScore).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /matches - finished match (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sport\": \"football\",\n  \"homeTeam\": \"Hidd\",\n  \"awayTeam\": \"Busaiteen\",\n  \"startTime\": \"{{pastStart}}\",\n  \"endTime\": \"{{pastEnd}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('derives status = finished', () => pm.expect(pm.response.json().data.status).to.eql('finished'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches - list (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('newest first', () => {",
                  "    const ids = pm.response.json().data.map((m) => m.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches?limit=2 - page 1 (saves cursor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches?limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('at most 2 rows', () => pm.expect(pm.response.json().data.length).to.be.at.most(2));",
                  "pm.test('returns a pagination block', () => {",
                  "    const page = pm.response.json().pagination;",
                  "    pm.expect(page).to.have.property('limit', 2);",
                  "    pm.expect(page).to.have.property('hasMore');",
                  "    pm.expect(page).to.have.property('nextCursor');",
                  "});",
                  "pm.test('newest first', () => {",
                  "    const ids = pm.response.json().data.map((m) => m.id);",
                  "    pm.expect(ids).to.eql([...ids].sort((a, b) => b - a));",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('nextCursor', body.pagination.nextCursor || '');",
                  "pm.collectionVariables.set('page1Ids', JSON.stringify(body.data.map((m) => m.id)));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches?cursor - page 2 (no overlap)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches?limit=2&cursor={{nextCursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                },
                {
                  "key": "cursor",
                  "value": "{{nextCursor}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only meaningful when page 1 reported a further page.",
                  "if (!pm.collectionVariables.get('nextCursor')) {",
                  "    pm.test.skip('page 2 - no further page to fetch', () => {});",
                  "} else {",
                  "    pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "    pm.test('no overlap with page 1', () => {",
                  "        const page1 = JSON.parse(pm.collectionVariables.get('page1Ids'));",
                  "        const page2 = pm.response.json().data.map((m) => m.id);",
                  "        const overlap = page2.filter((id) => page1.includes(id));",
                  "        pm.expect(overlap).to.eql([]);",
                  "    });",
                  "    pm.test('continues below page 1', () => {",
                  "        const page1 = JSON.parse(pm.collectionVariables.get('page1Ids'));",
                  "        const page2 = pm.response.json().data.map((m) => m.id);",
                  "        if (page2.length) pm.expect(Math.max(...page2)).to.be.below(Math.min(...page1));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Commentary",
      "description": "Runs after **Matches**, which stores the created match id in `{{matchId}}`.\n\nSequence numbers are unique per match, so these requests assume a fresh match each run.",
      "item": [
        {
          "name": "POST /matches/:id/commentary - full event (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sequence\": 1,\n  \"minute\": 23,\n  \"period\": \"1H\",\n  \"eventType\": \"goal\",\n  \"actor\": \"A. Hassan\",\n  \"team\": \"Riffa\",\n  \"message\": \"Goal for Riffa!\",\n  \"metadata\": {\n    \"xg\": 0.42,\n    \"assist\": \"M. Ali\"\n  },\n  \"tags\": [\n    \"goal\",\n    \"highlight\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/matches/{{matchId}}/commentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches",
                "{{matchId}}",
                "commentary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const event = pm.response.json().data;",
                  "pm.test('matchId comes from the URL', () => pm.expect(String(event.matchId)).to.eql(String(pm.collectionVariables.get('matchId'))));",
                  "pm.test('metadata round-trips as an object', () => pm.expect(event.metadata.xg).to.eql(0.42));",
                  "pm.test('tags round-trip as an array', () => pm.expect(event.tags).to.eql(['goal', 'highlight']));",
                  "pm.test('minute preserved', () => pm.expect(event.minute).to.eql(23));",
                  "pm.collectionVariables.set('commentaryId', event.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /matches/:id/commentary - minimal event (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sequence\": 2,\n  \"eventType\": \"kickoff\",\n  \"message\": \"We are underway.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/matches/{{matchId}}/commentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches",
                "{{matchId}}",
                "commentary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const event = pm.response.json().data;",
                  "pm.test('tags default to []', () => pm.expect(event.tags).to.eql([]));",
                  "pm.test('omitted optional fields are null', () => {",
                  "    pm.expect(event.minute).to.eql(null);",
                  "    pm.expect(event.metadata).to.eql(null);",
                  "    pm.expect(event.actor).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /matches/:id/commentary - duplicate sequence (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sequence\": 1,\n  \"minute\": 23,\n  \"period\": \"1H\",\n  \"eventType\": \"goal\",\n  \"actor\": \"A. Hassan\",\n  \"team\": \"Riffa\",\n  \"message\": \"Goal for Riffa!\",\n  \"metadata\": {\n    \"xg\": 0.42,\n    \"assist\": \"M. Ali\"\n  },\n  \"tags\": [\n    \"goal\",\n    \"highlight\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/matches/{{matchId}}/commentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches",
                "{{matchId}}",
                "commentary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Re-publishing sequence 1 must conflict, not duplicate the event.",
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('not a 500', () => pm.expect(pm.response.code).to.not.eql(500));",
                  "pm.test('explains the conflict', () => pm.expect(pm.response.json().error).to.contain('sequence'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches/:id/commentary - list (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches/{{matchId}}/commentary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches",
                "{{matchId}}",
                "commentary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns a data array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('every event belongs to this match', () => {",
                  "    const id = String(pm.collectionVariables.get('matchId'));",
                  "    pm.response.json().data.forEach((e) => pm.expect(String(e.matchId)).to.eql(id));",
                  "});",
                  "pm.test('newest first', () => {",
                  "    const seqs = pm.response.json().data.map((e) => e.sequence);",
                  "    pm.expect(seqs).to.eql([...seqs].sort((a, b) => b - a));",
                  "});",
                  "pm.test('includes both created events', () => {",
                  "    const seqs = pm.response.json().data.map((e) => e.sequence);",
                  "    pm.expect(seqs).to.include.members([1, 2]);",
                  "});",
                  "pm.test('metadata and tags deserialised', () => {",
                  "    const withMeta = pm.response.json().data.find((e) => e.sequence === 1);",
                  "    pm.expect(withMeta.metadata).to.be.an('object');",
                  "    pm.expect(withMeta.tags).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /matches/:id/commentary?limit=1 - respects limit (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/matches/{{matchId}}/commentary?limit=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "matches",
                "{{matchId}}",
                "commentary"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('exactly 1 row', () => pm.expect(pm.response.json().data.length).to.eql(1));",
                  "pm.test('returns the newest event', () => pm.expect(pm.response.json().data[0].sequence).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
